# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Every variable here is validated at process start by @atlas/env. A missing or
# malformed value fails the boot with every problem listed at once, rather than
# surfacing as `undefined` inside a request hours into a deploy.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
# Two roles, and the difference matters.
#
# DATABASE_URL is the *application* role. It holds neither SUPERUSER nor
# BYPASSRLS, which is what makes row-level security a real tenant boundary
# rather than a decoration. Pointing this at the owner or at `postgres` would
# silently disable every policy in packages/db/prisma/migrations.
DATABASE_URL=postgresql://atlas_app:atlas_app_pw@localhost:5432/atlas?schema=public

# DIRECT_DATABASE_URL is the *owner* role, used only by migrations and the test
# harness. Prisma Migrate holds advisory locks that a transaction-mode pooler
# cannot, so this must be an unpooled connection.
DIRECT_DATABASE_URL=postgresql://atlas_owner:atlas_owner_pw@localhost:5432/atlas?schema=public

# --- Sessions ----------------------------------------------------------------
SESSION_COOKIE_NAME=atlas_session
# Idle timeout: a session unused for this long ends.
SESSION_IDLE_TIMEOUT_SECONDS=604800
# Absolute timeout: a session ends this long after creation no matter how
# actively it is used. Bounds how long a stolen token stays useful.
SESSION_ABSOLUTE_TIMEOUT_SECONDS=2592000

# --- Invitations -------------------------------------------------------------
INVITATION_TTL_HOURS=168
